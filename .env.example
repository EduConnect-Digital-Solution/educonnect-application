# Everything prefixed VITE_ is built into the browser bundle and is public. Never put a secret here.

# Backend address, with no trailing slash and no /api. Required: the app refuses to start without it.
# Production: the Cloudflare address of the API, not the onrender.com one.
VITE_API_URL=https://your-backend-url.example.com

# Image uploads (profile photos, school logo). Uploads are switched off while the cloud name or preset is empty.
# The preset must be an UNSIGNED upload preset. Do not add the Cloudinary API key, secret or URL.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=educonnect/avatars

# Minutes without activity before the sign-out warning. Keep equal to the backend's SESSION_IDLE_TIMEOUT_MINUTES.
VITE_IDLE_TIMEOUT_MINUTES=30
